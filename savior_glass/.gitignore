# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Secrets
.env
.env.*
!.env.example

# Models (large binary files — download via install.sh)
models/*.pt
# 0.45 MB handwritten-letter fallback (writer-disjoint test 90.0 %, results/ekush_letters.json); tracked so the Pi gets it with git pull
!models/ekush_cnn.pt
# 82 MB RAF-DB emotion classifier (EfficientNetV2-S, 86.5 % on the RAF-DB test set); without it the Pi falls back to the weak FER+ model
!models/emotion_faces.pt
models/*.onnx
models/piper/*.onnx
models/piper/*.json
models/piper/engine/
models/yolov8n_ncnn_model/

# Logs
logs/*.log
logs/*.log.*

# Eval downloads
results/fer2013.csv

# Temp audio files
*.mp3
*.wav

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.code-workspace

# Keep empty model/log folders
!models/.gitkeep
!models/piper/.gitkeep
!logs/.gitkeep
